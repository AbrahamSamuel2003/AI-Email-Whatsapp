# Server Configuration
PORT=3005
HOST=0.0.0.0
NODE_ENV=development

# Database
DATABASE_URL="file:./dev.db"

# Security & Encryption (32-byte hex key for AES-256-GCM token encryption)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Google Gemini AI Configuration
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
AI_MODEL_NAME=gemini-3.6-flash

# WhatsApp Provider ("baileys" | "cloud_api" | "twilio" | "mock")
WHATSAPP_PROVIDER=baileys
CLIENT_WHATSAPP_NUMBER=+91xxxxxxxxxx

# Meta WhatsApp Cloud API (Optional - for production Cloud API mode)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=whatsapp_secret_verify_token_123

# Twilio WhatsApp (Optional - for Twilio mode)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Email Provider ("gmail" | "mock")
EMAIL_PROVIDER=gmail
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:3005/auth/google/callback

# Background Auto-Sync
AUTO_SYNC_ENABLED=true
AUTO_SYNC_INTERVAL_SECONDS=10

# Redis Queue (BullMQ - Optional)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
USE_REDIS_QUEUE=false
