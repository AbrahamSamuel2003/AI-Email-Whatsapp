# Server Configuration
PORT=3005
HOST=0.0.0.0
NODE_ENV=production
DATABASE_URL="file:./dev.db"
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# AI Provider (groq / gemini / mock)
AI_PROVIDER=groq
GROQ_API_KEY=""
GROQ_MODEL_NAME=openai/gpt-oss-20b
GEMINI_API_KEY=""
AI_MODEL_NAME=gemini-1.5-flash

# WhatsApp Provider (baileys / cloud_api / mock)
WHATSAPP_PROVIDER=baileys
CLIENT_WHATSAPP_NUMBER="+919876543210"
PHONE_ALERT_TOPIC="ss40-alerts-broadcast"

# Email & Polling
EMAIL_PROVIDER=gmail
AUTO_SYNC_ENABLED=true
AUTO_SYNC_INTERVAL_SECONDS=10
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3005/auth/google/callback"

# Portal URL
SS40_PORTAL_URL="http://localhost:3005"
ADMIN_SUPPORT_EMAIL="support@ss40network.com"
ADMIN_ALERT_ENABLED=true
ALERT_COOLDOWN_MINUTES=60
USE_REDIS_QUEUE=false
